# ========================================================
# Technical Home - Environment Variables Template
# ========================================================
# All sensitive production credentials must be placed here.
# DO NOT commit real API keys or secrets to public repositories.

# --- Firebase Configuration (Optional - for Auth & Firestore) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Supabase Database & Realtime (Recommended Free Tier) ---
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# --- Bunny.net Enterprise Video & Protected PDF Storage ---
# Get credentials from: https://dash.bunny.net/
VITE_BUNNY_STREAM_LIBRARY_ID=
VITE_BUNNY_STREAM_API_KEY=
VITE_BUNNY_STREAM_CDN_HOST=
VITE_BUNNY_STORAGE_ZONE_NAME=
VITE_BUNNY_STORAGE_PASSWORD=
VITE_BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
VITE_BUNNY_PULL_ZONE_HOSTNAME=

# --- Admin Master Passcode ---
VITE_ADMIN_MASTER_KEY=TECHNICALHOME2026

# --- YouTube Data API (Optional - for video playlist syncing) ---
VITE_YOUTUBE_API_KEY=

# --- EmailJS OTP Service (Optional - for student verification) ---
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
